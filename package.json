{
  "name": "hopp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "bun run validate && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "bun test tests/unit",
    "typecheck": "tsc --noEmit",
    "validate": "bun scripts/build-catalogue.ts && bun scripts/validate-hacks.ts",
    "test:e2e": "playwright test",
    "test:devices": "playwright test tests/e2e/devices.spec.ts",
    "test:ux": "playwright test tests/e2e/ux.spec.ts",
    "research:scan": "python3 scripts/scan-transfers.py",
    "research:report": "bun scripts/research-report.ts"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "vite": "6.4.1",
    "typescript": "5.9.3",
    "@types/bun": "1.3.8",
    "@playwright/test": "1.58.2",
    "@axe-core/playwright": "4.11.1"
  }
}
